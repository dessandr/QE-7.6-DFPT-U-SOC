
# IMPORTANT: this copy of Perturbo is compiled on top of this QE 7.6 tree
# (QE 7.6 DFPT+SOC+U port); upstream Perturbo targets QE 7.3.

# include make.inc of QE
include ../../make.inc


# for intel compiler
FFLAGS += -qopenmp -cpp -O3
LDFLAGS += -qopenmp

# path to HDF5 library
#IFLAGS += -I/path/to/hdf5/include
#HDF5_LIBS = -L/path/to/hdf5/lib -lhdf5 -lhdf5_fortran
# in case of ARM64 flag -L/usr/lib/aarch64-linux-gnu also can be useful

# for debug mode
#FFLAGS += -fbacktrace -fbounds-check -fcheck=all 
#LDFLAGS += -fbacktrace -fbounds-check -fcheck=all 

MODFLAGS= $(BASEMOD_FLAGS) \
          $(MOD_FLAG)../../PW/src \
          $(MOD_FLAG)../../dft-d3 \
          $(MOD_FLAG)../../LR_Modules \
          $(MOD_FLAG)../../PHonon/PH \
          $(CUDA_F90FLAGS)

          
PHMODS = ../../PHonon/PH/libph.a
LRMODS = ../../LR_Modules/liblrmod.a
# QE 7.6: as PHonon/PH/Makefile; devXlib comes with QELIBS (CUDA_LIBS)
PWOBJS = ../../PW/src/libpw.a ../../KS_Solvers/libks_solvers.a ../../dft-d3/libdftd3qe.a
QEMODS = $(BASEMODS)

F90FLAGS = $(FFLAGS) $(FDFLAGS) $(MODFLAGS) $(IFLAGS)
LDFLAGS += $(HDF5_LIB)
